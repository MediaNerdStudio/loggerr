<Window x:Class="Loggerr.Ingest.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Loggerr Ingest" Width="1120" Height="720" MinWidth="760" MinHeight="520">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Border Width="48" Height="48" CornerRadius="10" Margin="0,0,12,0" Background="{StaticResource AccentBrush}"><TextBlock Text="▮▮▮" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold"/></Border><StackPanel><TextBlock Text="LOGGERR INGEST" FontSize="22" FontWeight="Bold"/><TextBlock Text="Windows multi-device audio capture" Foreground="#81909D"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ServerUrl" Grid.Column="0" ToolTip="Loggerr server URL"/><PasswordBox x:Name="Token" Grid.Column="1" ToolTip="Ingest API token"/><Button Grid.Column="2" Content="Save &amp; discover" Click="Discover_Click"/><Button Grid.Column="3" Content="Refresh devices" Click="RefreshDevices_Click"/></Grid></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FeedList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Feed.Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Feed.Format.SampleRate, StringFormat={}{0} Hz}" Foreground="#81909D"/><TextBlock Text="{Binding State}" Foreground="#F0A33B"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"/><ComboBox Grid.Column="2" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" DisplayMemberPath="DisplayName"/><StackPanel Grid.Column="3" Margin="16,0"><Grid Height="12" Margin="0,3"><Border Background="#071016" CornerRadius="2"/><Border Width="{Binding LeftWidth}" HorizontalAlignment="Left" Background="#38D996" CornerRadius="2"/><TextBlock Text="L" FontSize="8" Margin="4,-1"/></Grid><Grid Height="12" Margin="0,3"><Border Background="#071016" CornerRadius="2"/><Border Width="{Binding RightWidth}" HorizontalAlignment="Left" Background="#38D996" CornerRadius="2"/><TextBlock Text="R" FontSize="8" Margin="4,-1"/></Grid></StackPanel><StackPanel Grid.Column="4"><Button Content="Start" Tag="{Binding}" Click="StartFeed_Click"/><Button Content="Stop" Tag="{Binding}" Click="StopFeed_Click"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock x:Name="GlobalStatus" Grid.Row="3" Foreground="#81909D" Margin="0,12,0,0" Text="Configure the server URL and token, then discover feeds."/>
  </Grid>
</Window>
